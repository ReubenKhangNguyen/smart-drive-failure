# HDFS
HDFS_REPLICATION_FACTOR=2
NAMENODE_WEB_PORT=9870
NAMENODE_RPC_PORT=9000

# Spark. Reduce these values to 1G and 1 on an 8 GB laptop.
SPARK_MASTER_WEB_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# Streamlit
DASHBOARD_PORT=8501

# Airflow (profile `orchestration`, Phase 7.b). Port is bound to 127.0.0.1 only.
# Set your own demo admin password in .env (never commit .env); it is left empty here on purpose.
AIRFLOW_WEB_PORT=8081
AIRFLOW_ADMIN_PASSWORD=

# Kafka demo (profile `streaming`, Phase 2.b). Published on 127.0.0.1 only.
KAFKA_PORT=9092
