# HDFS
HDFS_REPLICATION_FACTOR=2
NAMENODE_WEB_PORT=9870
NAMENODE_RPC_PORT=9000

# Spark. Reduce these values to 1G and 1 on an 8 GB laptop.
SPARK_MASTER_WEB_PORT=8082
SPARK_MASTER_PORT=7077
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# Kafka
KAFKA_EXTERNAL_PORT=9094
KAFKA_TOPIC=smart-drive-events

# Airflow web UI (username/password default to airflow/airflow)
AIRFLOW_WEB_PORT=8081
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# Web application
API_PORT=8000
FRONTEND_PORT=5173
